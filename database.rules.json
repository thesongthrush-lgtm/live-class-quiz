{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null && data.child('host').val() === auth.uid",
        ".write": "auth != null && (data.child('host').val() === auth.uid || (!data.exists() && newData.child('host').val() === auth.uid))",
        "state": {
          ".read": "auth != null"
        },
        "players": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games/' + $code + '/host').exists() && !data.child('kicked').exists() && !newData.child('kicked').exists()",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('emoji').isString() && newData.child('emoji').val().length <= 16"
          }
        },
        "answers": {
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games/' + $code + '/players/' + $uid + '/name').exists() && !root.child('games/' + $code + '/players/' + $uid + '/kicked').exists() && root.child('games/' + $code + '/state/phase').val() === 'question' && root.child('games/' + $code + '/state/qKey').val() === $q && root.child('games/' + $code + '/state/paused').val() !== true && now <= root.child('games/' + $code + '/state/deadline').val() + 1500",
              ".validate": "newData.hasChildren(['v', 't']) && newData.child('t').val() === now"
            }
          }
        },
        "req": {
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games/' + $code + '/state/qKey').val() === $q",
              ".validate": "newData.val() === 'hint'"
            }
          }
        },
        "flags": {
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === true"
            }
          }
        },
        "feedback": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
